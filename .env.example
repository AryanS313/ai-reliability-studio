# Hosted beta: isolated in-memory sessions, custom work and explicit visitor keys.
# Visitors use the main website; these settings are for developers/operators only.
# Use APP_ACCESS_MODE=local only with a trusted operator and loopback binding.
# Managed persistent hosting requires authenticated mode and deployment controls.
APP_ACCESS_MODE=hosted-session
APP_ENV=hosted-beta
AUTH_MODE=single-user
SINGLE_USER_EMAIL=local@ai-reliability-studio.invalid
SINGLE_USER_WORKSPACE=Local Workspace

# Persistent storage is used by local/authenticated modes, never anonymous sessions.
# Set DATABASE_URL through a secret manager for authenticated managed PostgreSQL.
DATABASE_PATH=data/ai_reliability_studio.db
DATABASE_URL=sqlite:///data/ai_reliability_studio.db
RETENTION_DAYS=90

# Trusted proxy authentication (production example).
AUTH_TRUSTED_PROXY=false
AUTH_ALLOWED_EMAIL_DOMAIN=
AUTH_SESSION_MAX_AGE_SECONDS=3600
# Default is false in development and true in production. Do not disable in shared hosting.
# AUTH_REQUIRE_ISSUED_AT=true

# Private-mode provider credentials. Never commit real values; prefer session inputs.
# Ambient provider base URLs, organization/project routing and proxies are ignored.
OPENAI_API_KEY=
OPENAI_MODEL_A=gpt-4o-mini
OPENAI_MODEL_B=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL_A=gemini-3.5-flash
GEMINI_MODEL_B=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_A=claude-sonnet-5
ANTHROPIC_MODEL_B=claude-haiku-4-5

# Upload and execution limits.
MAX_UPLOAD_BYTES=20971520
MAX_DATASET_ROWS=10000
MAX_DOCUMENTS_PER_UPLOAD=50
MAX_EXTRACTED_CHARACTERS=5000000
MAX_EXTERNAL_REQUEST_BYTES=2097152
MAX_EXTERNAL_RESPONSE_BYTES=5242880
MAX_EXPORT_ROWS=100000
# Default is false in development and true in production; an unavailable required scanner fails closed.
# REQUIRE_MALWARE_SCAN=true
EXTERNAL_TARGET_ALLOWED_HOSTS=
ALLOW_PRIVATE_EXTERNAL_TARGETS=false
LOG_RETENTION_DAYS=30
DEFAULT_TOP_K=3
DEFAULT_SIMILARITY_THRESHOLD=0.05
LATENCY_THRESHOLD_MS=3500
COST_THRESHOLD_USD=0.03
PRICING_VERSION=2026-08-20
PRICING_EFFECTIVE_DATE=2026-08-20
